{
  "name": "dsh-rivermind",
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "description": "Heads-up Texas Hold'em training for DeepSeek Harness, with an AI opponent, persistent public-action memory, and decision reviews.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && tsx src/host/dev.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:dsh": "node scripts/start-dsh.mjs",
    "prepare": "npm run build",
    "eval:heads-up": "node --import tsx src/eval/cli.ts",
    "release:check": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "poker",
    "agent",
    "memory"
  ],
  "files": [
    "dist/",
    "cordis.patch.yml",
    "docs/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangzeyuan/dsh-rivermind.git"
  },
  "homepage": "https://github.com/jiangzeyuan/dsh-rivermind#readme",
  "bugs": {
    "url": "https://github.com/jiangzeyuan/dsh-rivermind/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
